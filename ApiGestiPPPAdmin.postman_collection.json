{
  "info": {
    "name": "ApiGestiPPPAdmin",
    "description": "API REST para gestión de Prácticas Pre-Profesionales — UPeU.\n\n**Variables de entorno:**\n- `base_url`: http://localhost:8000/api\n- `token`: se llena automáticamente al hacer login\n\n**Flujo de autenticación:**\n1. Ejecuta `POST /login`\n2. Copia el token de la respuesta en la variable `token`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api", "type": "string" },
    { "key": "token",    "value": "",                          "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [

    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@upeu.edu.pe\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/register", "host": ["{{base_url}}"], "path": ["register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan\",\n  \"last_name\": \"Perez\",\n  \"email\": \"juan.perez@upeu.edu.pe\",\n  \"code\": \"2021100001\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/logout", "host": ["{{base_url}}"], "path": ["logout"] }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth", "refresh"] }
          }
        },
        {
          "name": "Get Perfil",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/perfil", "host": ["{{base_url}}"], "path": ["perfil"] }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/current-user", "host": ["{{base_url}}"], "path": ["current-user"] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/update-profile", "host": ["{{base_url}}"], "path": ["update-profile"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan\",\n  \"last_name\": \"Perez\",\n  \"email\": \"juan.perez@upeu.edu.pe\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Upload Photo",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/upload-photo", "host": ["{{base_url}}"], "path": ["upload-photo"] },
            "body": {
