          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/change-password", "host": ["{{base_url}}"], "path": ["change-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"new_password\": \"nuevaPassword123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
